<Project>
  <!-- Ortak ayarlar: Tools/Launcher altındaki tüm projeler. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Company>HAREKAT Studios</Company>
    <Product>HAREKAT Launcher</Product>
    <Version>0.1.0</Version>
    <!-- macOS/Linux üzerinde net10.0-windows projesini derleyebilmek için (yalnızca derleme; çalıştırma Windows'ta). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
