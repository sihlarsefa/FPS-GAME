{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "SqlServer",
    "JsonPath": "data/harekat.json"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=harekat.db",
    "SqlServer": "Server=localhost;Database=Harekat;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "harekat",
    "Audience": "harekat-clients",
    "Secret": "HarekatDevSecretKey_ChangeInProduction_Min32Chars!",
    "AccessMinutes": "60"
  },
  "Steam": {
    "AppId": "480",
    "WebApiKey": "",
    "AllowDevTickets": true
  },
  "RateLimit": {
    "PermitLimit": "120",
    "WindowSeconds": "60"
  },
  "Swagger": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "Alerts": {
    "QueueDepthWarning": 50,
    "ServerHeartbeatTimeoutSeconds": 45,
    "DbSlowQueryMs": 500
  }
}
