          },
          {
            "presentationSignal": "SmokeVolumeSpawned",
            "count": 1
          }
        ]
      },
      "rewardXp": 50
    },
    {
      "id": "poly_12_heal",
      "order": 12,
      "category": "survival",
      "goal": {
        "tr": "H ile sargı kullan; kullanımı tamamla (Completed).",
