{
  "schemaVersion": 1,
  "id": "harekat_training_range_v1",
  "title": {
    "tr": "Atış Poligonu — Temel Eğitim",
    "en": "Firing Range — Basic Training"
  },
  "scene": "TrainingRange",
  "bootstrap": "TrainingBootstrap",
  "eventNamespace": "Project.Core.Events",
  "notes": "success.coreEvent must match a type name in Project.Core.Events (without namespace). presentationSignal is for local UI/input gates not yet modeled as IGameEvent. filters use PascalCase property names from the event structs.",
  "telemetryEvents": [
    "tutorial_step_started",
    "tutorial_step_completed",
    "tutorial_chain_completed",
    "tutorial_abandoned",
    "first_order_issued",
    "first_artillery_call",
    "first_zone_damage",
    "session_d1_return"
  ],
  "defaultRewardXp": 25,
  "dailyXpCap": 400,
  "steps": [
    {
      "id": "poly_01_move",
      "order": 1,
      "category": "movement",
      "goal": {
        "tr": "WASD ile işaretli alana yürü; fare ile bakışını çevir.",
        "en": "Walk to the marked area with WASD; look around with the mouse."
      },
      "screenText": {
        "tr": "Hareket: W A S D · Bakış: Fare",
        "en": "Move: W A S D · Look: Mouse"
      },
      "hint": {
        "tr": "Koşmak için Shift tut. Zıplamak için Space.",
        "en": "Hold Shift to sprint. Space to jump."
      },
      "timeLimitSeconds": 90,
      "success": {
        "mode": "allOf",
        "conditions": [
          {
            "presentationSignal": "PlayerReachedWaypoint",
            "filters": { "WaypointId": "poly_start_pad" },
            "count": 1
          },
          {
            "presentationSignal": "LookDeltaSatisfied",
            "filters": { "YawDegrees": 45, "PitchDegrees": 20 },
            "count": 1
          }
        ]
      },
      "rewardXp": 25
    },
    {
      "id": "poly_02_crouch",
      "order": 2,
      "category": "movement",
      "goal": {
        "tr": "Ctrl veya C ile çömel; sonra ayağa kalk.",
        "en": "Crouch with Ctrl or C; then stand up."
      },
      "screenText": {
        "tr": "Çömel: Ctrl / C",
        "en": "Crouch: Ctrl / C"
      },
      "hint": {
        "tr": "Çömelince silüetin küçülür; nişan daha sabit olur.",
        "en": "Crouching shrinks your silhouette and steadies aim."
      },
      "timeLimitSeconds": 45,
      "success": {
        "mode": "allOf",
        "conditions": [
          {
            "presentationSignal": "StanceChanged",
            "filters": { "Stance": "Crouch" },
            "count": 1
          },
          {
            "presentationSignal": "StanceChanged",
            "filters": { "Stance": "Stand" },
            "count": 1
          }
        ]
      },
      "rewardXp": 25
    },
    {
      "id": "poly_03_prone",
      "order": 3,
      "category": "movement",
      "goal": {
        "tr": "Z ile yüzüstü yat; sonra ayağa kalk.",
        "en": "Go prone with Z; then stand up."
      },
      "screenText": {
        "tr": "Yüzüstü: Z",
        "en": "Prone: Z"
      },
      "hint": {
        "tr": "Yüzüstü iken hareket yavaştır; uzun menzilde avantaj sağlar.",
        "en": "Prone movement is slow but strong at long range."
      },
      "timeLimitSeconds": 45,
      "success": {
        "mode": "allOf",
        "conditions": [
          {
            "presentationSignal": "StanceChanged",
            "filters": { "Stance": "Prone" },
            "count": 1
          },
          {
            "presentationSignal": "StanceChanged",
            "filters": { "Stance": "Stand" },
            "count": 1
          }
        ]
      },
      "rewardXp": 25
    },
    {
      "id": "poly_04_lean",
      "order": 4,
      "category": "movement",
      "goal": {
        "tr": "Q ve E ile her iki yana birer kez eğil.",
        "en": "Lean left and right once with Q and E."
      },
      "screenText": {
        "tr": "Yana eğil: Q / E",
        "en": "Lean: Q / E"
      },
      "hint": {
        "tr": "Köşe arkası için eğil; sürekli eğik kalma, hedef olma.",
        "en": "Peek corners with lean; don’t stay exposed."
      },
      "timeLimitSeconds": 45,
      "success": {
        "mode": "allOf",
        "conditions": [
          {
            "presentationSignal": "LeanPerformed",
            "filters": { "Side": "Left" },
            "count": 1
          },
          {
            "presentationSignal": "LeanPerformed",
            "filters": { "Side": "Right" },
            "count": 1
          }
        ]
      },
      "rewardXp": 25
    },
    {
      "id": "poly_05_fire",
      "order": 5,
      "category": "weapons",
      "goal": {
        "tr": "Sol tık ile ateş et; 25 m hedefine 5 isabet kaydet.",
        "en": "Fire with LMB; land 5 hits on the 25 m target."
      },
      "screenText": {
        "tr": "Ateş: Sol Tık · Hedef: 25 m",
        "en": "Fire: LMB · Target: 25 m"
      },
      "hint": {
        "tr": "Poligonda mermi sınırsız. Kısa seriler daha isabetlidir.",
        "en": "Ammo is unlimited here. Short bursts hit more often."
      },
      "timeLimitSeconds": 90,
      "success": {
        "mode": "allOf",
        "conditions": [
          {
            "coreEvent": "WeaponFiredEvent",
            "count": 1
          },
          {
            "coreEvent": "HitConfirmedEvent",
            "filters": { "IsKill": false },
            "count": 5
          }
        ]
      },
      "rewardXp": 50
    },
    {
      "id": "poly_06_ads",
      "order": 6,
      "category": "weapons",
      "goal": {
        "tr": "Sağ tık ile nişan al (ADS); nişanlıyken 3 isabet yap.",
        "en": "Aim down sights (RMB); land 3 hits while aiming."
      },
      "screenText": {
        "tr": "Nişan: Sağ Tık (basılı tut)",
        "en": "ADS: Hold RMB"
      },
      "hint": {
        "tr": "Nişan alırken hassasiyet düşer (ADS çarpanı); yayılma daralır.",
        "en": "ADS lowers sensitivity and tightens spread."
      },
      "timeLimitSeconds": 90,
      "success": {
        "mode": "allOf",
        "conditions": [
          {
            "presentationSignal": "AdsActive",
            "filters": { "MinSeconds": 1.0 },
            "count": 1
          },
          {
            "coreEvent": "HitConfirmedEvent",
            "filters": { "WhileAiming": true },
            "count": 3,
            "notes": "WhileAiming is a presentation gate layered on HitConfirmedEvent (not a struct field)."
          }
        ]
      },
      "rewardXp": 50
    },
    {
      "id": "poly_07_scope",
      "order": 7,
      "category": "weapons",
      "goal": {
        "tr": "Dürbünlü silahla (KNT-76 veya JNG-90) 100 m hedefine nişan alıp 2 isabet yap.",
        "en": "With a scoped weapon (KNT-76 or JNG-90), hit the 100 m target twice."
      },
      "screenText": {
        "tr": "Dürbün: Sağ Tık · Mesafe: 100 m",
        "en": "Scope: RMB · Range: 100 m"
      },
      "hint": {
        "tr": "KNT-76 ≈ 3×, JNG-90 ≈ 6×. Dürbünde nefesini tutar gibi kısa durakla.",
        "en": "KNT-76 ≈ 3×, JNG-90 ≈ 6×. Pause briefly when scoped."
      },
      "timeLimitSeconds": 120,
      "loadoutHint": ["knt_76", "jng_90"],
      "success": {
        "mode": "allOf",
        "conditions": [
          {
            "presentationSignal": "ScopeActive",
            "filters": { "MinZoom": 2.5 },
            "count": 1
          },
          {
            "coreEvent": "HitConfirmedEvent",
            "filters": { "WhileScoped": true, "MinRangeMeters": 80 },
            "count": 2
          }
        ]
      },
      "rewardXp": 75
    },
    {
      "id": "poly_08_reload",
      "order": 8,
      "category": "weapons",
      "goal": {
        "tr": "R ile şarjör değiştir; şarjör bitene kadar bekle.",
        "en": "Reload with R; wait until the reload finishes."
      },
      "screenText": {
        "tr": "Şarjör: R",
        "en": "Reload: R"
      },
      "hint": {
        "tr": "Şarjör sırasında ateş edemezsin. Kapak arkasında değiştir.",
        "en": "You cannot fire while reloading. Reload behind cover."
      },
      "timeLimitSeconds": 60,
      "success": {
        "mode": "allOf",
        "conditions": [
          {
            "coreEvent": "WeaponReloadStartedEvent",
            "count": 1
          },
          {
            "coreEvent": "WeaponReloadedEvent",
            "count": 1
          }
        ]
      },
      "rewardXp": 25
    },
    {
      "id": "poly_09_firemode",
      "order": 9,
      "category": "weapons",
      "goal": {
        "tr": "B ile atış modunu değiştir (Tekli ↔ Otomatik); her modda en az 1 ateş et.",
        "en": "Cycle fire mode with B (Single ↔ Auto); fire at least once in each mode."
      },
      "screenText": {
        "tr": "Atış modu: B",
        "en": "Fire mode: B"
      },
      "hint": {
        "tr": "Uzun menzilde Tekli, yakın temasta Otomatik tercih et.",
        "en": "Prefer Single at range, Auto in close contact."
      },
      "timeLimitSeconds": 75,
      "success": {
        "mode": "allOf",
        "conditions": [
          {
            "presentationSignal": "FireModeChanged",
            "filters": { "FireMode": "Single" },
            "count": 1
          },
          {
            "presentationSignal": "FireModeChanged",
            "filters": { "FireMode": "Auto" },
            "count": 1
          },
          {
            "coreEvent": "WeaponFiredEvent",
            "count": 2
          }
        ]
      },
      "rewardXp": 50
    },
    {
      "id": "poly_10_frag",
      "order": 10,
      "category": "throwables",
      "goal": {
        "tr": "G ile el bombası at; işaretli kukla grubuna patlama isabeti kaydet.",
        "en": "Throw a frag with G; score an explosion hit on the marked dummy group."
      },
      "screenText": {
        "tr": "El bombası: G",
        "en": "Frag grenade: G"
      },
      "hint": {
        "tr": "Bombayı duvar arkasına sektirme; zamanlamayı öğren.",
        "en": "Bank frags around cover; learn the fuse timing."
      },
      "timeLimitSeconds": 90,
      "itemId": "grenade_frag",
      "success": {
        "mode": "anyOf",
        "conditions": [
          {
            "coreEvent": "ExplosionEvent",
            "filters": { "MinRadius": 1.0 },
            "count": 1
          },
          {
            "coreEvent": "ItemUsedEvent",
            "filters": { "ItemId": "grenade_frag", "Completed": true },
            "count": 1
          }
        ]
      },
      "rewardXp": 50
    },
    {
      "id": "poly_11_smoke",
      "order": 11,
      "category": "throwables",
      "goal": {
        "tr": "T ile sis bombası at; sis bulutu oluşsun.",
